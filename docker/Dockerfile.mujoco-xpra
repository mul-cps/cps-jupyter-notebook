# Minimal MuJoCo + Xpra desktop, derived from the shared desktop runtime.
ARG BASE_IMAGE=ghcr.io/mul-cps/cps-jupyter-notebook:latest-desktop-xpra-base
FROM ${BASE_IMAGE}

USER root
ENV MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl \
    NVIDIA_DRIVER_CAPABILITIES=compute,graphics,utility

RUN --mount=type=cache,target=/home/${NB_USER}/.cache/pip \
    set -eux; \
    pip install --upgrade --no-cache-dir mujoco gymnasium; \
    rm -rf /root/.cache

# The maintained Python bindings intentionally do not ship a `mujoco` shell
# command.  Provide a discoverable version helper without implying a separate
# native GUI binary; rendering is exposed through the Python API and Xpra.
RUN cat > /usr/local/bin/mujoco <<'EOF'
#!/bin/sh
set -eu
case "${1:-}" in
  -v|--version)
    exec python3 -c 'import mujoco; print(mujoco.__version__)'
    ;;
  "")
    echo "MuJoCo Python bindings are installed. Use: python -c 'import mujoco; print(mujoco.__version__)'" >&2
    echo "For interactive rendering, use mujoco.viewer from Python; launch Desktop (Xpra) from JupyterLab." >&2
    ;;
  *)
    echo "usage: mujoco [-v|--version]" >&2
    exit 2
    ;;
esac
EOF
RUN chmod 0755 /usr/local/bin/mujoco

# A notebook's default kernel is not attached to Xpra's virtual display.
# Provide an explicit kernel that routes GLFW through VirtualGL to :100 so
# `mujoco.viewer.launch()` opens in the Xpra desktop while EGL remains the
# default for off-screen rendering.
RUN install -d -m 0755 /usr/local/share/jupyter/kernels/python3-vgl-xpra && \
    cat > /usr/local/bin/start-vgl-xpra-kernel <<'EOF' && \
    chmod 0755 /usr/local/bin/start-vgl-xpra-kernel && \
    cat > /usr/local/share/jupyter/kernels/python3-vgl-xpra/kernel.json <<'EOF_JSON'
#!/bin/sh
set -eu
exec env DISPLAY=:100 vglrun /opt/conda/bin/python -m ipykernel_launcher "$@"
EOF
{
  "argv": [
    "/usr/local/bin/start-vgl-xpra-kernel",
    "-f",
    "{connection_file}"
  ],
  "display_name": "Python 3 (VirtualGL/Xpra)",
  "language": "python"
}
EOF_JSON

USER ${NB_UID}
WORKDIR /home/${NB_USER}/work
